# Public canonical URL (include base path)
NEXT_PUBLIC_SITE_URL=https://viralio.net/maurilio

# Admin preview remains closed in production unless explicitly enabled.
MAURILIO_ADMIN_PREVIEW=0

# Checkout is intentionally disabled by default.
MAURILIO_CHECKOUT_ENABLED=0
MAURILIO_PRO_PRICE_ARS=
MAURILIO_ELITE_PRICE_ARS=

# Server-only credential. Never prefix with NEXT_PUBLIC_.
MERCADOPAGO_ACCESS_TOKEN=

# Reserved for the verified webhook phase.
MERCADOPAGO_WEBHOOK_SECRET=
