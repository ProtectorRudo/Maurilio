# Public canonical URL (include base path)
NEXT_PUBLIC_SITE_URL=https://viralio.net/maurilio

# Admin preview remains closed in production unless explicitly enabled.
MAURILIO_ADMIN_PREVIEW=0

# Server-only Supabase access. Never prefix the secret with NEXT_PUBLIC_.
